/*
  Cache static assets aggressively. HTML stays short-lived so content updates land quickly.
*/

/*.html
  Cache-Control: no-cache, max-age=0, must-revalidate

/index.html
  Cache-Control: no-cache, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/styles.css
  Cache-Control: public, max-age=31536000, immutable

/global.js
  Cache-Control: public, max-age=31536000, immutable

/components.js
  Cache-Control: public, max-age=31536000, immutable

/cms-config.js
  Cache-Control: public, max-age=31536000, immutable